APP_ENV=production
DATABASE_URL=postgresql://USER:PASSWORD@PRIVATE_POSTGRES_HOST:5432/health_ai
DATABASE_SSLMODE=
DATABASE_POOL_SIZE=3
DATABASE_MAX_OVERFLOW=2
DATABASE_POOL_TIMEOUT=30
DATABASE_POOL_RECYCLE_SECONDS=300
REDIS_URL=redis://PRIVATE_REDIS_HOST:6379
REQUIRE_REDIS=true
SECRET_KEY=GENERATE_A_UNIQUE_256_BIT_SECRET
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7
CORS_ORIGINS=https://YOUR_FRONTEND_DOMAIN
FRONTEND_URL=https://YOUR_FRONTEND_DOMAIN
ALLOWED_HOSTS=YOUR_API_DOMAIN
FORCE_HTTPS=true
PUBLIC_API_DOCS=false
RUN_STARTUP_SCHEMA_CHECK=false
REQUIRE_ML_MODEL=true
ML_ARTIFACT_DIR=artifacts/ml
TRUSTED_PROXY_COUNT=1
MAX_REQUEST_BYTES=1048576
RATE_LIMIT_ENABLED=true
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_REQUESTS=20
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AI_ENABLED=false
GROQ_API_KEY=ROTATED_PRODUCTION_KEY
AI_MODEL=llama-3.1-8b-instant
AI_TIMEOUT_SECONDS=12
AI_MAX_RETRIES=1
AI_MAX_TOKENS=700
AI_DAILY_REQUEST_LIMIT=200
AI_CIRCUIT_FAILURE_THRESHOLD=3
AI_CIRCUIT_RESET_SECONDS=60
AI_DATA_STALE_HOURS=24
AI_MEMORY_ENCRYPTION_KEY=GENERATE_WITH_FERNET
AI_DATA_CLASSIFICATION=real
AI_PROVIDER_DPA_APPROVED=false
AI_RETENTION_REVIEWED=false
AI_REGIONAL_PROCESSING_APPROVED=false
AI_AUDIT_ENABLED=true
AI_CLINICAL_APPROVAL=false
WITHINGS_CLIENT_ID=PRODUCTION_CLIENT_ID
WITHINGS_CLIENT_SECRET=PRODUCTION_CLIENT_SECRET
WITHINGS_REDIRECT_URI=https://YOUR_API_DOMAIN/integrations/withings/callback
WITHINGS_WEBHOOK_URL=https://YOUR_API_DOMAIN/integrations/withings/webhook
INTEGRATION_ENCRYPTION_KEY=GENERATE_WITH_FERNET
REQUIRE_WITHINGS=true
SENTRY_DSN=https://YOUR_BACKEND_SENTRY_DSN
REQUIRE_SENTRY=true
SENTRY_TRACES_SAMPLE_RATE=0.1
RELEASE=YOUR_RELEASE_ID
