# Copy to .env only on the Alwaysdata host, fill the two required secrets,
# and chmod 600 .env. Never upload this completed file or paste it in chat.
APP_ENV=production
DATABASE_URL=
SECRET_KEY=
FRONTEND_URL=https://aihealthcaredashboard.vercel.app
CORS_ORIGINS=https://aihealthcaredashboard.vercel.app
ALLOWED_HOSTS=vitala.alwaysdata.net
FORCE_HTTPS=true
TRUSTED_PROXY_COUNT=1
PUBLIC_API_DOCS=false
RUN_STARTUP_SCHEMA_CHECK=false
REQUIRE_ML_MODEL=true
ML_ARTIFACT_DIR=artifacts/ml
AI_ENABLED=false
REQUIRE_WITHINGS=false
REQUIRE_REDIS=false
REQUIRE_SENTRY=false
AI_DATA_CLASSIFICATION=synthetic
